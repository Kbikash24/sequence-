{
  "name": "sequence-arena",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sequence/server --filter @sequence/web dev",
    "dev:server": "pnpm --filter @sequence/server dev",
    "dev:web": "pnpm --filter @sequence/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter @sequence/server --filter @sequence/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @sequence/server db:generate",
    "db:migrate": "pnpm --filter @sequence/server db:migrate",
    "db:deploy": "pnpm --filter @sequence/server db:deploy",
    "db:seed": "pnpm --filter @sequence/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
