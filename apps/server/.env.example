# Copy to .env and adjust.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:3000
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
# Omit to run without persistence (in-memory only).
DATABASE_URL=postgresql://sequence:sequence@localhost:5432/sequence_arena?schema=public
TURN_SECONDS=60
RECONNECT_SECONDS=60
